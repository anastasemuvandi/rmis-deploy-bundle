# RMIS deploy bundle — copy to `.env` and fill in. `.env` is gitignored.
#
# Consumed by:
#   • docker-compose.deploy.yml  -> CLIENT_SECRET (backend OIDC client secret)
#   • update_clients.sh          -> CLIENT_SECRET + KEYCLOAK_ADMIN* (registers rmis-portal)
#   • build_images.sh            -> SERVER_IP (sanity echo only)

# OIDC client secret for the `rmis-portal` Keycloak client. MUST be identical on
# both sides: the value update_clients.sh writes into Keycloak, and the value the
# RMIS backend authenticates with.
CLIENT_SECRET=

# Keycloak admin creds — match the running SSO stack (sso-deploy-bundle/.env).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=government-internal

# Public host the apps are reachable on (plain HTTP). Must match the baked-in
# frontend URLs and the SSO stack's KC_HOSTNAME.
SERVER_IP=10.10.73.8
